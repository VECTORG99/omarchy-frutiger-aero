;; Frutiger Aero Weather Widget

(defwindow weather
  :monitor 0
  :geometry (geometry :x "63%" :y "6%" :width 430 :height 550 :anchor "top center")
  :windowtype "notification"
  :stacking "overlay"
  :focusable false
  :decorations false
  :wm-ignore true
  :reserve (struts :distance "0" :enabled false)
  (weather-widget))

(defpoll weather_data :interval "1800s"
  :initial "{\"temp\":\"--\",\"condition\":\"Loading...\",\"city\":\"...\"}"
  `bash ~/.config/eww/scripts/weather.sh`)

(defwidget weather-widget []
  (box :class "weather-container"
       :orientation "v"
       :space-evenly false

       ;; Header
       (box :class "weather-header"
            :orientation "v"
            :space-evenly false

            ;; Actions row (top-right)
            (box :class "weather-actions"
                 :orientation "h"
                 :space-evenly false
                 :halign "end"
                 (button :onclick "eww update weather_data=\"$(bash ~/.config/eww/scripts/weather.sh)\""
                         (label :text "↻" :class "act-icon"))
                 (button :onclick "eww close weather"
                         (label :text "✕" :class "act-icon")))

            ;; Location (centered)
            (box :class "weather-location"
                 :orientation "v"
                 (box :orientation "h" :space-evenly false :halign "center"
                      (label :text "⊡" :class "loc-icon")
                      (label :text "${weather_data.city}" :class "loc-text"))
                 (label :text "${weather_data.condition} · ${weather_data.temp}°C" :class "header-sub" :halign "center")))

       ;; Current weather
       (box :class "weather-current"
            :orientation "v"
            :space-evenly false
            (box :class "weather-icon-wrap" :halign "center"
                 (image :path "${weather_data.icon}" :image-width 72 :image-height 72))
            (label :text "${weather_data.temp}°C" :class "weather-temp" :halign "center")
            (box :class "hi-lo-row" :orientation "h" :space-evenly false :halign "center"
                 (label :text "H:${weather_data.today_max}° L:${weather_data.today_min}°" :class "hi-lo-text")
                 (label :text "Feels ${weather_data.feels}°" :class "feels-text")))

       ;; Details row
       (box :class "weather-details"
            :orientation "h"
            :spacing 10
            :space-evenly true
            (box :class "detail-item" :orientation "v"
                 (label :text "≡" :class "detail-icon")
                 (label :text "${weather_data.humidity}%" :class "detail-value")
                 (label :text "Humidity" :class "detail-label"))
            (box :class "detail-item" :orientation "v"
                 (label :text "→" :class "detail-icon")
                 (label :text "${weather_data.wind}km/h" :class "detail-value")
                 (label :text "Wind" :class "detail-label"))
            (box :class "detail-item" :orientation "v"
                 (label :text "⊙" :class "detail-icon")
                 (label :text "${weather_data.uv}" :class "detail-value")
                 (label :text "UV" :class "detail-label"))
            (box :class "detail-item" :orientation "v"
                 (label :text "☁" :class "detail-icon")
                 (label :text "${weather_data.cloud}%" :class "detail-value")
                 (label :text "Cloud" :class "detail-label")))

       ;; Forecast
       (box :class "weather-forecast"
            :orientation "h"
            :spacing 12
            :space-evenly true
            (box :class "forecast-day" :orientation "v"
                 (image :path "${weather_data.fc0_icon}" :image-width 32 :image-height 32)
                 (label :text "${weather_data.fc0_day}" :class "fc-label")
                 (label :text "${weather_data.fc0_temp}°" :class "fc-temp")
                 (label :text "${weather_data.fc0_min}°" :class "fc-min"))
            (box :class "forecast-day" :orientation "v"
                 (image :path "${weather_data.fc1_icon}" :image-width 32 :image-height 32)
                 (label :text "${weather_data.fc1_day}" :class "fc-label")
                 (label :text "${weather_data.fc1_temp}°" :class "fc-temp")
                 (label :text "${weather_data.fc1_min}°" :class "fc-min"))
            (box :class "forecast-day" :orientation "v"
                 (image :path "${weather_data.fc2_icon}" :image-width 32 :image-height 32)
                 (label :text "${weather_data.fc2_day}" :class "fc-label")
                 (label :text "${weather_data.fc2_temp}°" :class "fc-temp")
                 (label :text "${weather_data.fc2_min}°" :class "fc-min")))

       ;; Updated + glass shine
       (box :class "footer-row"
            :orientation "h"
            :space-evenly false
             (label :text "Updated ${weather_data.updated_time}" :class "updated-text" :halign "center" :hexpand true)
             (box :class "glass-shine"))))

;; Frutiger Aero Clock Widget

(defwindow clock
  :monitor 0
  :geometry (geometry :x "3%" :y "6%" :width 460 :height 240 :anchor "top left")
  :windowtype "notification"
  :stacking "overlay"
  :focusable false
  :decorations false
  :wm-ignore true
  :reserve (struts :distance "0" :enabled false)
  (clock-widget))

(defpoll clock_data :interval "1s"
  :initial "{}"
  `bash ~/.config/eww/scripts/clock.sh`)

(defwidget clock-widget []
  (box :class "clock-container"
       :orientation "v"
       :space-evenly false

       ;; Top glossy separator
       (box :class "clock-sep-top")

       ;; Timezone + AM/PM
       (box :class "clock-top"
            :orientation "h"
            :space-evenly false
            (label :text "GMT${clock_data.tz}" :class "clock-tz")
            (label :text "${clock_data.ampm}" :class "clock-ampm" :hexpand true :halign "end"))

       ;; Glossy accent line
       (box :class "clock-accent")

       ;; Main time panel
       (box :class "clock-panel"
            :orientation "v"
            :space-evenly false
            (box :class "clock-time-row"
                 :orientation "h"
                 :space-evenly false
                 :halign "center"
                 (label :text "${clock_data.hour}" :class "clock-digit")
                 (label :text ":" :class "clock-colon")
                 (label :text "${clock_data.minute}" :class "clock-digit"))
            (box :class "clock-sec-row"
                 :orientation "h"
                 :space-evenly false
                 :halign "center"
                 (label :text "${clock_data.second}" :class "clock-sec")
                 (label :text "SEC" :class "clock-sec-label")))

       ;; Bottom glossy separator
       (box :class "clock-sep-bottom")

       ;; Date
       (label :text "${clock_data.weekday}  ${clock_data.month} ${clock_data.day}" :class "clock-date")

        ;; Glass shine
       (box :class "glass-shine")))

;; Calendar Widget

(defwindow calendar
  :monitor 0
  :geometry (geometry :x "2%" :y "24%" :width 340 :height 340 :anchor "bottom left")
  :windowtype "notification"
  :stacking "overlay"
  :focusable false
  :decorations false
  :wm-ignore true
  (calendar-widget))

(defpoll cal_data :interval "5s"
  :initial "{}"
  `bash ~/.config/eww/scripts/calendar.sh 0`)

(defwidget calendar-widget []
  (box :class "cal-container"
       :orientation "v"
       :space-evenly false

       ;; Header
       (box :class "cal-header"
            :orientation "h"
            :space-evenly false
            :halign "center"
            (button :onclick "eww update cal_data=\"$(bash ~/.config/eww/scripts/calendar.sh -1)\""
                    (label :text "<" :class "cal-nav"))
            (label :text "${cal_data.month} ${cal_data.year}" :class "cal-month")
            (button :onclick "eww update cal_data=\"$(bash ~/.config/eww/scripts/calendar.sh 1)\""
                    (label :text ">" :class "cal-nav")))

       ;; Glossy separator
       (box :class "clock-sep-bottom")

       ;; Weekday labels
       (box :class "cal-weekdays"
            :orientation "h"
            :space-evenly true
            (label :text "SUN" :class "cal-wday")
            (label :text "MON" :class "cal-wday")
            (label :text "TUE" :class "cal-wday")
            (label :text "WED" :class "cal-wday")
            (label :text "THU" :class "cal-wday")
            (label :text "FRI" :class "cal-wday")
            (label :text "SAT" :class "cal-wday"))

       ;; Day grid
       (box :class "cal-grid"
            :orientation "v"
            :space-evenly false
            (box :class "cal-row" :orientation "h" :space-evenly true
                 (label :text "${cal_data.d00}" :class "cal-day")
                 (label :text "${cal_data.d01}" :class "cal-day")
                 (label :text "${cal_data.d02}" :class "cal-day")
                 (label :text "${cal_data.d03}" :class "cal-day")
                 (label :text "${cal_data.d04}" :class "cal-day")
                 (label :text "${cal_data.d05}" :class "cal-day")
                 (label :text "${cal_data.d06}" :class "cal-day"))
            (box :class "cal-row" :orientation "h" :space-evenly true
                 (label :text "${cal_data.d07}" :class "cal-day")
                 (label :text "${cal_data.d08}" :class "cal-day")
                 (label :text "${cal_data.d09}" :class "cal-day")
                 (label :text "${cal_data.d10}" :class "cal-day")
                 (label :text "${cal_data.d11}" :class "cal-day")
                 (label :text "${cal_data.d12}" :class "cal-day")
                 (label :text "${cal_data.d13}" :class "cal-day"))
            (box :class "cal-row" :orientation "h" :space-evenly true
                 (label :text "${cal_data.d14}" :class "cal-day")
                 (label :text "${cal_data.d15}" :class "cal-day")
                 (label :text "${cal_data.d16}" :class "cal-day")
                 (label :text "${cal_data.d17}" :class "cal-day")
                 (label :text "${cal_data.d18}" :class "cal-day")
                 (label :text "${cal_data.d19}" :class "cal-day")
                 (label :text "${cal_data.d20}" :class "cal-day"))
            (box :class "cal-row" :orientation "h" :space-evenly true
                 (label :text "${cal_data.d21}" :class "cal-day")
                 (label :text "${cal_data.d22}" :class "cal-day")
                 (label :text "${cal_data.d23}" :class "cal-day")
                 (label :text "${cal_data.d24}" :class "cal-day")
                 (label :text "${cal_data.d25}" :class "cal-day")
                 (label :text "${cal_data.d26}" :class "cal-day")
                 (label :text "${cal_data.d27}" :class "cal-day"))
            (box :class "cal-row" :orientation "h" :space-evenly true
                 (label :text "${cal_data.d28}" :class "cal-day")
                 (label :text "${cal_data.d29}" :class "cal-day")
                 (label :text "${cal_data.d30}" :class "cal-day")
                 (label :text "${cal_data.d31}" :class "cal-day")
                 (label :text "${cal_data.d32}" :class "cal-day")
                 (label :text "${cal_data.d33}" :class "cal-day")
                 (label :text "${cal_data.d34}" :class "cal-day"))
            (box :class "cal-row" :orientation "h" :space-evenly true
                 (label :text "${cal_data.d35}" :class "cal-day")
                 (label :text "${cal_data.d36}" :class "cal-day")
                 (label :text "${cal_data.d37}" :class "cal-day")
                 (label :text "${cal_data.d38}" :class "cal-day")
                 (label :text "${cal_data.d39}" :class "cal-day")
                 (label :text "${cal_data.d40}" :class "cal-day")
                 (label :text "${cal_data.d41}" :class "cal-day")))

       ;; Glass shine
       (box :class "glass-shine")))

;; Music Player Widget

(defwindow music
  :monitor 0
  :geometry (geometry :x "2%" :y "55%" :width 340 :height 320 :anchor "bottom left")
  :windowtype "notification"
  :stacking "overlay"
  :focusable false
  :decorations false
  :wm-ignore true
  (music-widget))

(defpoll music_data :interval "2s"
  :initial "{\"title\":\"---\",\"artist\":\"---\",\"status\":\"stopped\"}"
  `bash ~/.config/eww/scripts/music.sh`)

(defwidget music-widget []
  (box :class "music-container"
       :orientation "v"
       :space-evenly false

       ;; Display panel (Pioneer LCD style)
       (box :class "music-display"
            :orientation "v"
            :space-evenly false

            ;; Equalizer bars
            (box :class "music-eq"
                 :orientation "h"
                 :space-evenly false
                 :halign "center"
                 (box :class "eq-bar" :style "animation-delay:0ms")
                 (box :class "eq-bar" :style "animation-delay:80ms")
                 (box :class "eq-bar" :style "animation-delay:160ms")
                 (box :class "eq-bar" :style "animation-delay:40ms")
                 (box :class "eq-bar" :style "animation-delay:200ms")
                 (box :class "eq-bar" :style "animation-delay:120ms")
                 (box :class "eq-bar" :style "animation-delay:60ms")
                 (box :class "eq-bar" :style "animation-delay:180ms")
                 (box :class "eq-bar" :style "animation-delay:100ms")
                 (box :class "eq-bar" :style "animation-delay:20ms")
                 (box :class "eq-bar" :style "animation-delay:140ms")
                 (box :class "eq-bar" :style "animation-delay:90ms"))

            ;; Track info
            (box :class "music-track-info"
                 :orientation "v"
                 :space-evenly false
                 (label :text "${music_data.title}" :class "music-title")
                 (label :text "${music_data.artist}" :class "music-artist"))

            ;; Status indicator
            (label :text "${music_data.status}" :class "music-status"))

       ;; Metallic separator
       (box :class "music-sep")

       ;; Controls (Pioneer buttons)
       (box :class "music-controls"
            :orientation "h"
            :space-evenly true
            :halign "center"
            (button :onclick "playerctl previous"
                    (box :class "music-btn-wrap" :orientation "v"
                         (label :text "⏮" :class "music-btn-icon")
                         (label :text "PREV" :class "music-btn-label")))
            (button :onclick "playerctl play-pause"
                    (box :class "music-btn-wrap music-btn-main" :orientation "v"
                         (label :text "⏯" :class "music-btn-icon music-icon-big")
                         (label :text "PLAY" :class "music-btn-label")))
            (button :onclick "playerctl next"
                    (box :class "music-btn-wrap" :orientation "v"
                         (label :text "⏭" :class "music-btn-icon")
                         (label :text "NEXT" :class "music-btn-label"))))

       ;; Glass shine
       (box :class "glass-shine")))

;; Widget Control Panel

(defwindow widget-ctl
  :monitor 0
  :geometry (geometry :x "2%" :y "1%" :width 340 :height 220 :anchor "bottom left")
  :windowtype "notification"
  :stacking "overlay"
  :focusable false
  :decorations false
  :wm-ignore true
  (widget-ctl-widget))

(defpoll weather_status :interval "1s"
  :initial "off"
  `bash ~/.config/eww/scripts/widget-status.sh weather`)

(defpoll clock_status :interval "1s"
  :initial "off"
  `bash ~/.config/eww/scripts/widget-status.sh clock`)

(defpoll calendar_status :interval "1s"
  :initial "off"
  `bash ~/.config/eww/scripts/widget-status.sh calendar`)

(defpoll music_status :interval "1s"
  :initial "off"
  `bash ~/.config/eww/scripts/widget-status.sh music`)

(defwidget widget-ctl-widget []
  (box :class "ctl-container"
       :orientation "v"
       :space-evenly false

       ;; Title
       (label :text "Widget Control" :class "ctl-title")
       (label :text "SUPER+SHIFT+Q" :class "ctl-subtitle")

       ;; Weather
       (box :class "ctl-row"
            :orientation "h"
            :space-evenly false
            (box :class "ctl-info" :orientation "v"
                 (label :text "Weather" :class "ctl-label")
                 (label :text "SUPER+SHIFT+T" :class "ctl-key"))
            (box :hexpand true)
            (box :class "ctl-status-box" :orientation "h"
                 (label :text "${weather_status}" :class "ctl-status"))
            (button :onclick "bash ~/.config/eww/scripts/widget-ctl.sh toggle weather"
                    (label :text "TOGGLE" :class "ctl-btn")))

       ;; Clock
       (box :class "ctl-row"
            :orientation "h"
            :space-evenly false
            (box :class "ctl-info" :orientation "v"
                 (label :text "Clock" :class "ctl-label")
                 (label :text "SUPER+SHIFT+K" :class "ctl-key"))
            (box :hexpand true)
            (box :class "ctl-status-box" :orientation "h"
                 (label :text "${clock_status}" :class "ctl-status"))
             (button :onclick "bash ~/.config/eww/scripts/widget-ctl.sh toggle clock"
                     (label :text "TOGGLE" :class "ctl-btn")))

       ;; Calendar
       (box :class "ctl-row"
            :orientation "h"
            :space-evenly false
            (box :class "ctl-info" :orientation "v"
                 (label :text "Calendar" :class "ctl-label")
                 (label :text "SUPER+SHIFT+L" :class "ctl-key"))
            (box :hexpand true)
            (box :class "ctl-status-box" :orientation "h"
                 (label :text "${calendar_status}" :class "ctl-status"))
             (button :onclick "bash ~/.config/eww/scripts/widget-ctl.sh toggle calendar"
                     (label :text "TOGGLE" :class "ctl-btn")))

       ;; Music
       (box :class "ctl-row"
            :orientation "h"
            :space-evenly false
            (box :class "ctl-info" :orientation "v"
                 (label :text "Music" :class "ctl-label")
                 (label :text "SUPER+SHIFT+R" :class "ctl-key"))
            (box :hexpand true)
            (box :class "ctl-status-box" :orientation "h"
                 (label :text "${music_status}" :class "ctl-status"))
            (button :onclick "bash ~/.config/eww/scripts/widget-ctl.sh toggle music"
                    (label :text "TOGGLE" :class "ctl-btn")))

       ;; Glass shine
       (box :class "glass-shine")))
